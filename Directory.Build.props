<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!--
      Globalization data is required rather than optional here. Quiet hours are stored against the
      device's own IANA zone, and with invariant globalization TimeZoneInfo cannot resolve one, so the
      feature would throw at runtime instead of failing a build. The runtime image carries ICU.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Repository metadata">
    <Authors>Tunahan Ali Ozturk</Authors>
    <Product>Pitchwire</Product>
    <RepositoryUrl>https://github.com/tunahanaliozturk/pitchwire</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
