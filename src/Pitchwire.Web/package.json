{
  "name": "pitchwire-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "budget": "node scripts/bundle-budget.mjs",
    "licences": "node scripts/licence-audit.mjs",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src",
    "format:check": "prettier --check src scripts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "contract": "node ../../scripts/dump-openapi.mjs && npm run contract:types",
    "contract:types": "openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@microsoft/signalr": "10.0.11",
    "@tanstack/vue-query": "5.103.1",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/vue": "8.1.0",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.1",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.0",
    "eslint-plugin-vuejs-accessibility": "2.6.0",
    "jsdom": "30.1.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11",
    "workbox-precaching": "^7.4.1"
  }
}
