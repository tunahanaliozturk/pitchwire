        "type": "object",
        "properties": {
          "providerEventId": {
            "type": "string"
          },
          "matchId": {
            "type": "string",
            "format": "uuid"
          },
          "sequence": {
            "type": "integer",
            "format": "int32"
          },
          "minute": {
            "type": "integer",
            "format": "int32"
          },
          "kind": {
            "$ref": "#/components/schemas/MatchEventKind"
          },
          "teamId": {
            "type": "string",
            "format": "uuid"
          },
          "playerId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "assistPlayerId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
