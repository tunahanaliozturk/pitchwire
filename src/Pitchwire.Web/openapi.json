        "required": [
          "sequence",
          "minute",
          "kind",
          "teamId",
          "player",
          "assist"
        ],
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "format": "int32"
          },
          "minute": {
            "type": "integer",
            "format": "int32"
          },
          "kind": {
            "type": "string"
          },
          "teamId": {
            "type": "string",
            "format": "uuid"
          },
          "player": {
            "type": [
              "null",
              "string"
            ]
          },
          "assist": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MatchSummary": {
        "required": [
          "id",
          "round",
          "kickoffUtc",
          "status",
          "minute",
          "homeScore",
          "awayScore",
          "isDegraded",
          "home",
          "away"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "round": {
            "type": "integer",
            "format": "int32"
          },
          "kickoffUtc": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "minute": {
            "type": "integer",
            "format": "int32"
          },
          "homeScore": {
            "type": "integer",
            "format": "int32"
          },
          "awayScore": {
            "type": "integer",
            "format": "int32"
          },
          "isDegraded": {
            "type": "boolean"
          },
          "home": {
            "$ref": "#/components/schemas/TeamRef"
          },
          "away": {
            "$ref": "#/components/schemas/TeamRef"
          }
        }
      },
      "PageOfMatchSummary": {
        "required": [
          "value",
          "nextLink"
        ],
        "type": "object",
        "properties": {
          "value": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MatchSummary"
            }
          },
          "nextLink": {
            "type": [
              "null",
              "string"
            ]
          }
        }
