        "required": [
          "timeZoneId",
          "quietHoursStart",
          "quietHoursEnd",
          "notifyOnGoal",
          "notifyOnRedCard",
          "notifyOnKickoff",
          "notifyOnFullTime"
        ],
        "type": "object",
        "properties": {
          "timeZoneId": {
            "type": "string"
          },
          "quietHoursStart": {
            "type": [
              "null",
              "string"
            ],
            "format": "time"
          },
          "quietHoursEnd": {
            "type": [
              "null",
              "string"
            ],
            "format": "time"
          },
          "notifyOnGoal": {
            "type": "boolean"
          },
          "notifyOnRedCard": {
            "type": "boolean"
          },
          "notifyOnKickoff": {
            "type": "boolean"
          },
          "notifyOnFullTime": {
            "type": "boolean"
          }
        }
      },
