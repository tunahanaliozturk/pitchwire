        "type": "object",
        "properties": {
          "position": {
            "type": "integer",
            "format": "int32"
          },
          "team": {
            "$ref": "#/components/schemas/TeamRef"
          },
          "played": {
            "type": "integer",
            "format": "int32"
          },
          "won": {
            "type": "integer",
            "format": "int32"
          },
          "drawn": {
            "type": "integer",
            "format": "int32"
          },
          "lost": {
            "type": "integer",
            "format": "int32"
          },
          "goalsFor": {
            "type": "integer",
            "format": "int32"
          },
          "goalsAgainst": {
            "type": "integer",
            "format": "int32"
          },
          "goalDifference": {
            "type": "integer",
            "format": "int32"
          },
          "points": {
            "type": "integer",
            "format": "int32"
