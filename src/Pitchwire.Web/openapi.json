        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "leagueId": {
            "type": "string",
            "format": "uuid"
          },
          "league": {
            "type": "string"
          },
          "leagueSlug": {
            "type": "string"
          }
        }
      },
