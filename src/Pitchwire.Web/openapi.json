        "type": "object",
        "properties": {
          "publicKey": {
            "type": "string"
          }
        }
      },
      "ScorerRow": {
        "required": [
          "playerId",
          "player",
          "team",
          "goals",
          "assists"
        ],
        "type": "object",
        "properties": {
          "playerId": {
            "type": "string",
            "format": "uuid"
          },
          "player": {
            "type": "string"
