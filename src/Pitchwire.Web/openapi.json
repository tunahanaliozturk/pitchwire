  "components": {
    "schemas": {
      "DeviceSettings": {
        "required": [
          "id",
          "timeZoneId",
          "quietHoursStart",
          "quietHoursEnd",
          "notifyOnGoal",
          "notifyOnRedCard",
          "notifyOnKickoff",
          "notifyOnFullTime",
          "favourites"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "timeZoneId": {
            "type": "string"
          },
          "quietHoursStart": {
            "type": [
              "null",
              "string"
            ],
            "format": "time"
          },
          "quietHoursEnd": {
            "type": [
              "null",
              "string"
            ],
            "format": "time"
          },
          "notifyOnGoal": {
            "type": "boolean"
          },
          "notifyOnRedCard": {
            "type": "boolean"
          },
          "notifyOnKickoff": {
            "type": "boolean"
          },
          "notifyOnFullTime": {
            "type": "boolean"
          },
          "favourites": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "FavouritesRequest": {
        "required": [
          "teamIds"
        ],
        "type": "object",
        "properties": {
          "teamIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "FormEntry": {
        "required": [
          "matchId",
          "kickoffUtc",
          "opponent",
          "atHome",
          "goalsFor",
          "goalsAgainst",
          "outcome"
        ],
        "type": "object",
        "properties": {
          "matchId": {
            "type": "string",
            "format": "uuid"
          },
          "kickoffUtc": {
            "type": "string",
            "format": "date-time"
          },
          "opponent": {
            "$ref": "#/components/schemas/TeamRef"
          },
          "atHome": {
            "type": "boolean"
          },
          "goalsFor": {
            "type": "integer",
            "format": "int32"
          },
          "goalsAgainst": {
            "type": "integer",
            "format": "int32"
          },
          "outcome": {
            "type": "string"
          }
        }
      },
      "IngestRequest": {
        "required": [
          "events"
        ],
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MatchEventPayload"
            }
          }
        }
      },
      "IngestResponse": {
        "required": [
          "accepted",
          "duplicate",
          "rejected"
        ],
        "type": "object",
        "properties": {
          "accepted": {
            "type": "integer",
            "format": "int32"
          },
          "duplicate": {
            "type": "integer",
            "format": "int32"
          },
          "rejected": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "MatchDetail": {
        "required": [
          "match",
          "timeline"
        ],
        "type": "object",
        "properties": {
          "match": {
            "$ref": "#/components/schemas/MatchSummary"
          },
          "timeline": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MatchEventView"
            }
          }
        }
      },
      "MatchEventKind": {
        "type": "integer"
      },
      "MatchEventPayload": {
        "required": [
          "providerEventId",
          "matchId",
          "sequence",
          "minute",
          "kind",
          "teamId",
          "playerId",
          "assistPlayerId",
          "occurredAt"
